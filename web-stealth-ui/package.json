{
  "name": "@local/web-stealth-ui",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.7-alpha.2 <0.3.0"
  },
  "description": "Settings page for the stealth web provider: pick the exit and the claims about where it is, and run the interactive cookie harvest.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-locale"]
    }
  }
}
